/// Client-side configuration.
///
/// Everything here ships inside the app binary, so it must contain only values
/// that are safe to be public: AdMob unit IDs, the Sentry DSN and the backend
/// URLs are all designed to be readable by anyone who unzips the APK.
///
/// Never add a database URL, an API secret or a payment secret to this file.
/// Those belong to the backend only (see deploy/.env on the server); a phone
/// must never hold a credential that talks to Postgres or PayPal directly.
///
/// This is the TEMPLATE. CI copies it to api_keys.dart (which is gitignored so a
/// developer can point a local build at a different backend). Because every value
/// here is public by design, the template carries the real values rather than
/// blanks — a build made from it talks to the live backend out of the box. Keep
/// this file in sync with any member the app reads off ApiKeys, or the CI build
/// breaks with "getter isn't defined for the type 'ApiKeys'".
class ApiKeys {
  // ==================== ADMOB ====================
  // Ad unit IDs are public identifiers, not secrets.
  static const String admobBannerAndroid = 'ca-app-pub-8491001524308476/7116257088';
  static const String admobBannerIos = 'ca-app-pub-8491001524308476/4681665438';

  static const String admobInterstitialAndroid = 'ca-app-pub-8491001524308476/9581997693';
  static const String admobInterstitialIos = 'ca-app-pub-8491001524308476/5179718251';

  static const String admobRewardedAndroid = 'ca-app-pub-8491001524308476/8248347684';
  static const String admobRewardedIos = 'ca-app-pub-8491001524308476/3041280706';

  // ==================== SENTRY ====================
  /// Empty disables Sentry. A DSN is a public ingest URL, not a secret.
  /// Override at build time: --dart-define=SENTRY_DSN=https://...
  static const String sentryDsn = String.fromEnvironment('SENTRY_DSN');

  // ==================== BACKEND ====================
  /// Self-hosted API and multiplayer socket (Ampere, behind the Cloudflare tunnel).
  static const String serverUrl = 'https://tokerrgjik.shabanejupi.tech/api';
  static const String websocketUrl = 'wss://tokerrgjik.shabanejupi.tech';

  /// Public site: where the web build is served, and where PayPal returns the
  /// player after checkout. Every user-facing link must be built from this — the
  /// old tokerrgjik.netlify.app origin is being retired.
  static const String siteUrl = 'https://tokerrgjik.shabanejupi.tech';

  /// Point a debug build at a local backend:
  ///   --dart-define=API_BASE=http://10.0.2.2:3000 --dart-define=WS_BASE=ws://10.0.2.2:3001
  static const String _apiOverride = String.fromEnvironment('API_BASE');
  static const String _wsOverride = String.fromEnvironment('WS_BASE');

  static String get currentServerUrl =>
      _apiOverride.isNotEmpty ? _apiOverride : serverUrl;

  static String get currentWebsocketUrl =>
      _wsOverride.isNotEmpty ? _wsOverride : websocketUrl;
}
