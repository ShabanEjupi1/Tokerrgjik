<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Interneti duhet për lojën online dhe për reklamat. Kamera, njoftimet
         dhe gjendja e rrjetit u hoqën bashkë me paketat që i kërkonin — sa më
         pak leje, aq më pak pyetje te Play.

         🚨 `com.google.android.gms.permission.AD_ID` NUK shkruhet këtu: e shton
         vetë SDK-ja e reklamave gjatë bashkimit të manifesteve. Duhet vetëm
         DEKLARUAR te Play Console → Siguria e të dhënave («Identifikues
         pajisjeje ose përdoruesi», mblidhen dhe ndahen, për reklama). -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:label="Tokërrgjik"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Identifikuesi i aplikacionit te AdMob. Pa këtë rresht aplikacioni
             RRËZOHET në nisje me një përjashtim të qartë nga SDK-ja — jo në
             heshtje, ndaj s'ka si të kalojë pa u vënë re. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1776059573171352~3673667026"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
